# Token que TÚ inventas y registras en Meta for Developers al configurar el webhook
WHATSAPP_VERIFY_TOKEN=

# Estos se usan a partir de SCRUM-84 (envío de mensajes), aún no en esta etapa
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Se usa a partir del primer nodo de LangGraph (SCRUM-85)
GEMINI_API_KEY=

# Modo de operacion: "pruebas" (solo el equipo) o "produccion" (clientes reales)
MIA_MODO=pruebas
# En modo pruebas, solo estos numeros reciben respuesta (separados por coma, sin '+')
NUMEROS_PERMITIDOS=

# Numero que aprueba las citas (SCRUM-77). En modo pruebas: el de un
# integrante del equipo. En produccion: el de la propietaria.
PROPIETARIA_WHATSAPP=

# Opcionales (tienen valores por defecto)
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_EMBED_MODEL=gemini-embedding-001
# MIA_DB_PATH=data/mia.sqlite3
# RAG_BACKEND=local            # o pgvector (requiere SUPABASE_DB_URL)
# SUPABASE_DB_URL=
# VISION_BACKEND=auto          # auto | cnn | gemini

# Panel web (/panel): demo + agenda + dashboard de la propietaria.
# Sin DEMO_CLAVE solo funciona desde la propia maquina (localhost).
DEMO_CLAVE=

# Google Calendar (opcional): las citas aprobadas se crean como eventos.
# Compartir el calendario con el correo de la cuenta de servicio ("Hacer cambios en eventos").
GOOGLE_CALENDAR_ID=
# Contenido completo del JSON de la cuenta de servicio (en Railway, pegarlo como variable)
GOOGLE_SERVICE_ACCOUNT_JSON=
# o, en local, la ruta al archivo:
# GOOGLE_SERVICE_ACCOUNT_FILE=credenciales/cuenta_servicio.json
