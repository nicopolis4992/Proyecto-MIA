# Entorno "pruebas" en Railway: el equipo prueba aqui. Ningun cliente real.
# Copiar cada linea como variable en Railway (Variables -> Raw Editor).
# Los valores entre <> se reemplazan; nunca subir este archivo con secretos.

MIA_MODO=pruebas
NUMEROS_PERMITIDOS=<593...del equipo, separados por coma>
PROPIETARIA_WHATSAPP=<593... de quien hace de propietaria>

GEMINI_API_KEY=<clave con limite de gasto bajo>

# WhatsApp: numero de PRUEBA de Meta (app "Lina's Pet - pruebas")
WHATSAPP_VERIFY_TOKEN=<cadena inventada, la misma que se pone en Meta>
WHATSAPP_ACCESS_TOKEN=<token permanente del usuario del sistema>
WHATSAPP_PHONE_NUMBER_ID=<id del numero de prueba>
# Plantillas (cuando Meta las apruebe; ver docs/plantillas_meta.md)
WHATSAPP_PLANTILLA_PROPIETARIA=
WHATSAPP_PLANTILLA_CLIENTE=

# Base en el volumen montado en /data (sin volumen se pierde en cada despliegue)
MIA_DB_PATH=/data/mia.sqlite3

# Panel: https://<app>.up.railway.app/panel?clave=<DEMO_CLAVE>
DEMO_CLAVE=<clave larga>

# Opcionales
GOOGLE_CALENDAR_ID=<calendario "Lina's Pet Salon (pruebas)">
GOOGLE_SERVICE_ACCOUNT_JSON=<contenido del JSON de la cuenta de servicio>
CORREO_USUARIO=<cuenta que envia>
CORREO_CLAVE=<contrasena de aplicacion>
CORREO_PROPIETARIA=<correo del equipo>
