# Entorno "piloto" en Railway: clientes reales y la propietaria.
# Solo se despliega lo que ya paso por "pruebas" (rama main).

MIA_MODO=produccion
PROPIETARIA_WHATSAPP=<593... de la propietaria>

GEMINI_API_KEY=<clave PROPIA del piloto, para medir el costo real>

# WhatsApp: numero del NEGOCIO (app "Lina's Pet - piloto", distinta de la de pruebas)
WHATSAPP_VERIFY_TOKEN=<otra cadena inventada>
WHATSAPP_ACCESS_TOKEN=<token permanente del usuario del sistema del negocio>
WHATSAPP_PHONE_NUMBER_ID=<id del numero del negocio>
WHATSAPP_PLANTILLA_PROPIETARIA=aviso_propietaria
WHATSAPP_PLANTILLA_CLIENTE=aviso_cliente

# Cifrado de datos personales (ver .env.example para generar las claves).
# Guardarlas tambien en un lugar seguro: sin ellas no se pueden leer los datos.
MIA_CLAVES_CIFRADO=<clave Fernet>
MIA_CLAVE_SEUDONIMO_OPERACION=<texto aleatorio de 32+ caracteres>

# OTRO volumen, montado en /data de este entorno
MIA_DB_PATH=/data/mia.sqlite3

DEMO_CLAVE=<otra clave, distinta de la de pruebas>

GOOGLE_CALENDAR_ID=<calendario del NEGOCIO>
GOOGLE_SERVICE_ACCOUNT_JSON=<JSON de la cuenta de servicio>
CORREO_USUARIO=<cuenta que envia>
CORREO_CLAVE=<contrasena de aplicacion>
CORREO_PROPIETARIA=<correo de la propietaria>
